#
# gw_source.cmake - record which axioma-oracle commit a gateway binary is
# built from, for AX:STATE:v1 (CONTRACT.md section 6). Runs at every build.
#
# The value is the 40-hex HEAD only when SRC is the top level of a git
# checkout with no modified tracked files; otherwise it is "unknown". It
# never names a commit the build cannot be shown to come from.
#
# usage: cmake -DSRC=<axioma-oracle> -DOUT=<header> -P gw_source.cmake

set(value "unknown")
find_program(GIT_EXE git)
if(GIT_EXE)
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --show-toplevel
                    RESULT_VARIABLE r0 OUTPUT_VARIABLE top
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    get_filename_component(src_real "${SRC}" REALPATH)
    if(r0 EQUAL 0)
        get_filename_component(top_real "${top}" REALPATH)
    endif()
    if(r0 EQUAL 0 AND top_real STREQUAL src_real)
        execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --verify HEAD
                        RESULT_VARIABLE r1 OUTPUT_VARIABLE head
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND ${GIT_EXE} --no-optional-locks -C ${SRC}
                                status --porcelain --untracked-files=no
                        RESULT_VARIABLE r2 OUTPUT_VARIABLE dirty ERROR_QUIET)
        if(r1 EQUAL 0 AND r2 EQUAL 0 AND dirty STREQUAL ""
           AND head MATCHES "^[0-9a-f]+$")
            string(LENGTH "${head}" n)
            if(n EQUAL 40)
                set(value "${head}")
            endif()
        endif()
    endif()
endif()

file(WRITE "${OUT}.tmp"
     "/* Generated by gateway/cmake/gw_source.cmake at build time. */\n"
     "#define GW_SOURCE_COMMIT \"${value}\"\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
