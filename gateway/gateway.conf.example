# axioma-gateway configuration example
# Copy to /etc/axioma-gateway.conf and adjust. Unknown keys are rejected.
# The SHA-256 of this file is committed to the evidence chain as
# AX:STATE:v1 at every service start.

# Required
socket_path=/var/lib/axioma-gateway/gw.sock
ledger_path=/var/lib/axioma-gateway/l6-evidence.bin
wal_path=/var/lib/axioma-gateway/wal.open
log_path=/var/lib/axioma-gateway/gw.log
# model_id and oracle_id are checked at load with the admission rules:
# non-empty valid UTF-8, no control character (0x00-0x1F) or DEL (0x7F),
# at most 255 bytes. A config that fails the check is refused.
model_id=claude-haiku-4-5-20251001

# Provider surface (defaults shown)
#api_url=https://api.anthropic.com/v1/messages
# anthropic_version is sent as an HTTP header value: a control character
# (0x00-0x1F) or DEL (0x7F) in it is refused at load.
#anthropic_version=2023-06-01
#oracle_id=anthropic-messages-api

# Client contract (defaults shown)
#connect_timeout_s=10
#response_timeout_s=300
#max_attempts=1
# 1 is the supported configuration: one accepted request, at most one
# upstream transmission, one record (CONTRACT.md R-4). Values up to 10
# retry after 429/5xx; each retry is a further transmission that the
# record does not show (only the log does), so they are outside the
# contract.
#max_response_bytes=4194304

# Spend guard: refusals past this per-run count are pre-spend and
# log-only. Raise deliberately per evaluation stage.
#call_budget=25

# Request defaults and bounds
#default_max_tokens=1024
#max_prompt_bytes=32768
